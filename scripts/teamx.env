# TeamX shared settings — every script in scripts/ reads this file.
# If the Wi-Fi hands out new IPs, fix them HERE (and in dns/teamx.hosts, nginx/*.conf, firewall/*.conf).

DOMAIN="app.teamX.test"
HTTPS_PORT="443"

MAC1_DNS_PRIMARY="10.7.23.138"
MAC2_EDGE_PRIMARY="10.7.3.38"
MAC3_BACKEND_A="10.7.3.174"     # also: backup DNS + standby edge in Phase 2
MAC4_BACKEND_B="10.7.31.162"

PORT_A="3001"
PORT_B="3002"

DNS_SERVERS="$MAC1_DNS_PRIMARY $MAC3_BACKEND_A"

# Local CA file (only used by openssl s_client in diagnose.sh; curl uses the Keychain)
CA_FILE="${CA_FILE:-$HOME/CN_Project/cn-certs/rootCA.pem}"
